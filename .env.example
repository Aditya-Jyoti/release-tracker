# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Optional: GitHub personal access token (no scopes needed for public repos).
# Raises the API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Poll interval in seconds (min 60)
CHECK_INTERVAL_SECONDS=900

# SQLite path. In Docker this is overridden to /data/tracker.db (the volume).
DB_PATH=data/tracker.db

# Optional comma-separated chat IDs allowed to use the bot. Empty = anyone.
# Group chat IDs are negative (e.g. -1001234567890).
ALLOWED_CHAT_IDS=

# Fall back to git tags for repos that have no GitHub releases (true/false)
GITHUB_FALLBACK_TO_TAGS=true

# Logging: LOG_LEVEL=DEBUG|INFO|WARNING, LOG_FORMAT=json|text
LOG_LEVEL=INFO
LOG_FORMAT=json
